[Unit]
Description=VeriStockDB daily Close update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=veristock
Group=veristock
WorkingDirectory=/opt/veristockdb/app
EnvironmentFile=/etc/veristockdb/veristockdb.env
ExecStart=/usr/bin/python3 /opt/veristockdb/app/main.py update-close
StandardOutput=append:/var/log/veristockdb/update-close.log
StandardError=append:/var/log/veristockdb/update-close.log
