# Copy to /etc/veristockdb/veristockdb.env on the Ubuntu server.
VERISTOCK_DB_PATH=/srv/veristockdb/app/data/db/veristock.db
VERISTOCK_CSV_DIR=/srv/veristockdb/app/data/csv
VERISTOCK_ARCHIVE_DIR=/app/dirty_box/veristockdb/archive
VERISTOCK_BACKUP_DIR=/app/dirty_box/veristockdb/backup
VERISTOCK_LOG_DIR=/srv/veristockdb/logs

# Local Truth API, keep local or bind to a private ZeroTier/VPN IP only.
VERISTOCK_API_HOST=127.0.0.1
VERISTOCK_API_PORT=8000
VERISTOCK_API_REQUIRE_AUTH=0
# VERISTOCK_API_READ_TOKEN=
# VERISTOCK_API_OPS_TOKEN=
# VERISTOCK_API_ADMIN_TOKEN=

# Telegram notifications. Keep the real bot token only in /etc/veristockdb/veristockdb.env.
VERISTOCK_TELEGRAM_ENABLED=0
# VERISTOCK_TELEGRAM_BOT_TOKEN=
# VERISTOCK_TELEGRAM_CHAT_ID=
VERISTOCK_TELEGRAM_TIMEOUT_SECONDS=10
VERISTOCK_TELEGRAM_NOTIFY_SUCCESS=1
VERISTOCK_TELEGRAM_NOTIFY_WARNING=1
VERISTOCK_TELEGRAM_NOTIFY_FAILURE=1
