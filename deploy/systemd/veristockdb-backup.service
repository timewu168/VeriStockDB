[Unit]
Description=VeriStockDB SQLite backup

[Service]
Type=oneshot
User=veristock
Group=veristock
WorkingDirectory=/opt/veristockdb/app
EnvironmentFile=/etc/veristockdb/veristockdb.env
ExecStart=/usr/bin/python3 /opt/veristockdb/app/main.py backup
StandardOutput=append:/var/log/veristockdb/backup.log
StandardError=append:/var/log/veristockdb/backup.log
