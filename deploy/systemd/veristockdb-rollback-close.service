[Unit]
Description=VeriStockDB Close rollback check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=veristock
Group=veristock
WorkingDirectory=/opt/veristockdb/app
EnvironmentFile=/etc/veristockdb/veristockdb.env
ExecStart=/usr/bin/python3 /opt/veristockdb/app/main.py rollback-close
StandardOutput=append:/var/log/veristockdb/rollback-close.log
StandardError=append:/var/log/veristockdb/rollback-close.log
